DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fila_auditoria_eficacia
DB_CONNECTION_TIMEOUT=10
# Aiven / MySQL externo: use a porta informada no painel do Aiven e TLS.
# Sem DB_SSL_CA, a conexao continua criptografada, mas nao valida o certificado.
DB_SSL_ENABLED=true
DB_SSL_VERIFY_CERT=false
DB_SSL_VERIFY_IDENTITY=false
# Para validar o certificado no Aiven, baixe o CA e use um caminho absoluto:
# DB_SSL_CA=C:/caminho/seguro/ca.pem
# DB_SSL_VERIFY_CERT=true
# DB_SSL_VERIFY_IDENTITY=true
FLASK_DEBUG=false
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# Deixe como está quando a interface for servida pelo Flask na porta 5000.
# Para um front-end em outro IP ou domínio, use a origem pública exata: http://192.168.0.20:3000
# Em uma rede local temporária, CORS_ORIGINS=* permite qualquer origem; restrinja-o em produção.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
FLASK_HOST=0.0.0.0
